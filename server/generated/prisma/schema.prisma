generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  name       String?
  email      String?  @unique
  password   String?
  avatarPath String?  @default("https://www.gravatar.com/avatar/") @map("avatar_path")

  @@map("user")
}
